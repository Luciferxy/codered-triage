# CodeRed Triage Configuration
# Copy this file to .env and insert your real credentials. Do not commit .env.

# Rime Text-to-Speech API
# Model choices: mist_v3 (low-latency, ~40ms), coda (conversational fidelity)
RIME_API_KEY=your_rime_api_key_here
RIME_MODEL_ID=mist_v3
RIME_SPEAKER=celeste
RIME_LANGUAGE=en
RIME_AUDIO_FORMAT=pcm
RIME_SAMPLING_RATE=24000

# LiveKit WebRTC & Agent Configuration
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_api_secret_here

# LLM Reasoning Engine (OpenAI / Groq / Anthropic)
OPENAI_API_KEY=your_openai_or_groq_api_key_here

# Server & Simulator Settings
PORT=8080
HOST=0.0.0.0
SIMULATE_OFFLINE=true
