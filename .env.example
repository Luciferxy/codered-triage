# CodeRed Triage Configuration
# Copy this file to .env and insert your real credentials. Do not commit .env.

# Rime Text-to-Speech API
# Model choices: mist_v3 (low-latency, ~40ms), coda (conversational fidelity)
RIME_API_KEY=your_rime_api_key_here
RIME_MODEL_ID=mist_v3
RIME_SPEAKER=falcon
RIME_LANGUAGE=en
RIME_AUDIO_FORMAT=pcm
RIME_SAMPLING_RATE=24000
RIME_ENDPOINT=https://users.rime.ai/v1/rime-tts

# LiveKit WebRTC & Agent Configuration
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_api_secret_here

# OpenRouter / OpenAI Reasoning Engine
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Server & Simulator Settings
PORT=8080
HOST=0.0.0.0
SIMULATE_OFFLINE=false
